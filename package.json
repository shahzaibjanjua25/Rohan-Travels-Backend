{
  "name": "rohan-travels-backend",
  "version": "1.0.0",
  "description": "REST API for Rohan Travels flight booking management",
  "main": "server.js",
  "type": "commonjs",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "build": "echo 'No build step required for backend API'",
    "vercel-build": "echo 'Vercel build step completed'",
    "seed": "node src/seeders/index.js",
    "seed:admin": "node src/seeders/adminSeeder.js",
    "seed:flights": "node src/seeders/flightSeeder.js",
    "seed:ledger": "node src/seeders/seedLeger.js",
    "test:integration": "node tests/auth.integration.js && node tests/flights.integration.js && node tests/bookings.integration.js && node tests/reporting.integration.js && node tests/users.integration.js",
    "test:auth": "node tests/auth.integration.js",
    "test:flights": "node tests/flights.integration.js",
    "test:bookings": "node tests/bookings.integration.js",
    "test:reporting": "node tests/reporting.integration.js",
    "test:users": "node tests/users.integration.js"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.2.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.3",
    "mongoose-lean-virtuals": "^2.1.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "nodemailer": "^6.9.16"
  },
  "devDependencies": {
    "nodemon": "^3.1.7",
    "supertest": "^7.0.0"
  }
}